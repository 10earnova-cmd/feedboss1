{
  "name": "feedboss1",
  "main": "server/cloudflare.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "feedboss"
    }
  ],
  "vars": {
    "FIREBASE_WEB_API_KEY": "AIzaSyDWkkSuH8tuan2uyTAregqeRgjxZFEQ_RY"
  }
}
