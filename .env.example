# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_ADMIN_EMAIL=am@gmail.com

# Upload API (Vite proxies /api → local R2 server)
VITE_R2_WORKER_URL=/api
VITE_R2_PUBLIC_BASE=
VITE_R2_UPLOAD_SECRET=

# CORS — Cloudflare Worker (comma-separated)
ALLOWED_ORIGINS=https://getvideo.fun,https://www.getvideo.fun

# Server-only R2 S3 credentials (DO NOT prefix with VITE_)
# Also add these on Vercel → Project → Settings → Environment Variables
R2_ACCOUNT_ID=
R2_BUCKET=feedboss
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
API_PORT=8788
FIREBASE_WEB_API_KEY=
